{
  "productName": "360 Media Viewer",
  "appId": "cf.sht-vr-player",
  "directories": {
    "buildResources": "build_resources",
    "output": "dist_electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "src/config/**/*",
    "src/models/**/*",
    "build_resources/icon/png/icon.png",
    "project.config.js",
    "package.json"
  ],
  "asarUnpack": ["node_modules/exiftool-vendored.pl/**"],
  "fileAssociations": [
    {
      "ext": "insp",
      "name": "Insta360 photo",
      "description": "Insta360 photo",
      "mimeType": "image/x-360-media-viewer-insp"
    }
  ],
  "linux": {
    "target": ["deb", "AppImage"],
    "category": "Graphics",
    "icon": "build_resources/icon/png",
    "mimeTypes": ["inode/directory", "image/jpeg", "image/png", "video/mp4"],
    "syncDesktopName": true,
    "synopsis": "360-degree media viewer for Linux.",
    "description": "Browse and view 360-degree photos and videos on Linux."
  },
  "deb": {
    "depends": ["ffmpeg", "graphicsmagick", "perl", "python3"],
    "mimeTypes": []
  },
  "appImage": {
    "artifactName": "${name}-${version}.${ext}",
    "mimeTypes": []
  },
  "publish": [
    {
      "provider": "github",
      "owner": "shturnev",
      "repo": "ubuntu-360-player"
    }
  ]
}
