{
  "productName": "360 Media Viewer",
  "appId": "cf.sht-vr-player",
  "directories": {
    "buildResources": "build_resources",
    "output": "dist_electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "src/config/**/*",
    "src/models/**/*",
    "build_resources/icon/png/icon.png",
    "project.config.js",
    "package.json"
  ],
  "linux": {
    "target": ["deb", "AppImage"],
    "category": "Graphics",
    "icon": "build_resources/icon/png",
    "syncDesktopName": true,
    "synopsis": "360-degree media viewer for Linux.",
    "description": "Browse and view 360-degree photos and videos on Linux."
  },
  "deb": {
    "depends": ["ffmpeg", "graphicsmagick"]
  }
}
