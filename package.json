{
  "version": "1.0.5",
  "name": "360-media-player",
  "author": "Shturnev Sergii <sergii@shturnev.com>",
  "license": "MIT",
  "private": true,
  "repository": "https://github.com/shturnev/ubuntu-360-player",
  "description": "360 media player for desktop Linux with Electron and React",
  "homepage": "tbd",
  "keywords": [
    "vr",
    "360",
    "360 media player",
    "vr-player",
    "vrplayer",
    "panorama",
    "vrreality"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 0.0.0.0",
    "dev:electron": "electron .",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "jest --runInBand",
    "electron:build": "npm run build && electron-builder --config electron-builder.json",
    "electron:dist": "electron-builder --config electron-builder.json --linux deb"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "get-folder-size": "^2.0.1",
    "gm": "^1.23.1",
    "lodash": "^4.17.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "trash": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.1",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^29.7.0",
    "cli-color": "^1.4.0",
    "command-exists": "^1.2.8",
    "concurrently": "^9.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react-devtools-core": "^8.0.0",
    "rimraf": "^6.0.0",
    "sass": "^1.108.1",
    "vite": "^8.3.7",
    "wait-on": "^8.0.0"
  }
}
