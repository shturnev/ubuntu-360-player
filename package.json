{
  "version": "3.1.2",
  "name": "360-media-viewer",
  "author": "Shturnev Sergii <sergii@shturnev.com>",
  "license": "BUSL-1.1",
  "private": true,
  "repository": "https://github.com/shturnev/ubuntu-360-player",
  "description": "360 media viewer for desktop Linux with Electron and React",
  "homepage": "tbd",
  "keywords": [
    "vr",
    "360",
    "360 media viewer",
    "360-media-viewer",
    "vr-viewer",
    "panorama",
    "vrreality"
  ],
  "main": "electron/main.js",
  "desktopName": "360-media-viewer",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 0.0.0.0",
    "dev:electron": "electron .",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --fix --ext .js,.jsx",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,json,html,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,json,html,css,scss}\"",
    "electron:build": "npm run build && electron-builder --config electron-builder.json",
    "electron:dist": "npm run electron:build"
  },
  "dependencies": {
    "cli-color": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.11",
    "express": "^4.17.1",
    "get-folder-size": "^2.0.1",
    "gm": "^1.23.1",
    "lodash": "^4.17.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.0",
    "trash": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.1",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^29.7.0",
    "command-exists": "^1.2.8",
    "concurrently": "^9.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.10.0",
    "react-devtools-core": "^8.0.0",
    "sass": "^1.108.1",
    "vite": "^8.3.7",
    "wait-on": "^8.0.0"
  }
}
